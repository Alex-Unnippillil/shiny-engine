{
  "compilerOptions": {
    "target": "ES2022", "module": "ES2022", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "strict": true,
    "noUncheckedIndexedAccess": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "noEmitOnError": true, "useDefineForClassFields": true,
    "rootDir": ".", "outDir": "dist/compiled", "skipLibCheck": true
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts"]
}
